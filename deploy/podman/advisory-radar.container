# Podman quadlet for advisory-radar (rootless). Prerequisites (Podman version, lingering, subuid ranges) and the rootful
# variant: docs/deployment.md#podman-quadlet-rootless
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/podman/advisory-radar.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start advisory-radar
# Secrets: put them in ~/.config/advisory-radar.env (mode 600) - the quadlet
# references it with EnvironmentFile. Never commit that file.
#
# UserNS=keep-id: the image runs as UID 10001, and a rootless container cannot
# write a host directory owned by your account unless its UID is mapped to yours.
#
# Image=: `latest` follows every stable release. Pin a release (vX.Y.Z) or a digest (@sha256:...) to make each
# update a decision you take; docs/deployment.md#image-tags-updates-and-rollback has the update and rollback steps.

[Container]
Image=ghcr.io/mikomiel/advisory-radar:latest
ContainerName=advisory-radar
# Loopback only: the web UI has a login but no TLS. Put a TLS-terminating reverse proxy in front of it to reach it
# from other machines (docs/deployment.md#exposing-the-web-ui) instead of widening this address.
PublishPort=127.0.0.1:8080:8080
Volume=%h/.config/advisory-radar:/config:ro
Volume=%h/.local/share/advisory-radar:/data
UserNS=keep-id:uid=10001,gid=10001
NoNewPrivileges=true
DropCapability=ALL
EnvironmentFile=%h/.config/advisory-radar.env
Environment=ADVISORY_RADAR_CONFIG=/config/config.yml
# To keep the login token in a Podman secret instead of the env file, create the secret as described in
# docs/deployment.md#keeping-secrets-out-of-env, remove the token from the env file, then uncomment:
# Secret=advisory-radar-token,type=env,target=ADVISORY_RADAR_AUTH_TOKEN
# The probe is a subcommand of the image, so HealthCmd is plain words: the quadlet generator mangles a quoted command.
HealthCmd=advisory-radar healthcheck
HealthStartPeriod=10s
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
# Wait between restarts, so a configuration error is a slow loop in the journal and not a burst that trips systemd's
# start limit.
RestartSec=10
# The first start pulls the image, and systemd's default 90 s is too short for a slow link.
TimeoutStartSec=900

[Install]
WantedBy=default.target
